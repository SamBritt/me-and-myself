PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase "Session pooler" connection string (Project Settings → Database → Connect → Session pooler).
# The direct connection (db.<ref>.supabase.co) is IPv6-only on the free tier and won't work on
# IPv4-only networks — use the pooler host instead. Note the username includes the project ref.
DATABASE_URL="postgresql://postgres.xxxxxxxx:password@aws-0-<region>.pooler.supabase.com:5432/postgres"

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=replace-with-current-sonnet-model-id

BCRYPT_SALT_ROUNDS=12
